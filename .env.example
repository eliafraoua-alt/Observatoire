# ─── Observatoire RPDF — Variables d'environnement ───────────────────────────
# Copier ce fichier en .env et renseigner les valeurs réelles.
# NE JAMAIS committer le fichier .env (déjà dans .gitignore).

# ── MinIO / Data Lake ──────────────────────────────────────────────────────────
# En dev local, les valeurs par défaut ci-dessous fonctionnent directement.
# En production, générer des identifiants forts et les stocker dans
# AWS Secrets Manager (cf infra/terraform/main.tf).
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── DuckDB ───────────────────────────────────────────────────────────────────
DUCKDB_PATH=/data/warehouse.duckdb

# ── API INSEE ────────────────────────────────────────────────────────────────
# Inscription gratuite sur https://api.insee.fr pour obtenir un jeton.
# Sans ce jeton, le pipeline utilise des données de repli (mock) basées
# sur les chiffres connus de l'étude Nikonoff/INSEE RP2021.
INSEE_TOKEN=

# ── API France Travail (ex-Pôle Emploi) ───────────────────────────────────────
# Créer une application sur https://francetravail.io/data/api pour obtenir
# un client_id et un client_secret.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_SECRET=

# ── Sécurité API — authentification ───────────────────────────────────────────
# Clé API requise pour interroger les endpoints de l'observatoire (sauf /health
# et / qui restent publics). Générer une clé forte avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changez-moi-avant-toute-mise-en-production

# Domaines autorisés à appeler l'API depuis un navigateur (CORS), séparés
# par des virgules. En dev local, les dashboards tournent sur ces ports.
API_CORS_ORIGINS=http://localhost:8501,http://localhost:8511,http://localhost:8512,http://localhost:8513,http://localhost:8514

# ── Notifications ──────────────────────────────────────────────────────────────
# Webhook Slack pour les alertes de déploiement et les signaux forts détectés
# par le pipeline NLP. Créer sur https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# ── Airflow (production uniquement — généré automatiquement en dev) ──────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changez-moi-avant-toute-mise-en-production

# ── AWS (déploiement production uniquement) ───────────────────────────────────
AWS_ACCOUNT_ID=
AWS_REGION=eu-west-3
